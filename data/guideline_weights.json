  "patient_state_weight_modifiers": {
    "description": "How patient metrics shift TOPSIS weights dynamically",
    "egfr_below_30": {
      "drug_interaction_risk_weight_boost": 0.10,
      "rationale": "CKD G4/G5 patients are at extreme risk of drug toxicity — increase drug risk weight"
    },
    "lvef_below_40": {
      "evidence_level_weight_boost": 0.05,
      "rationale": "HFrEF patients benefit most from guideline-directed medical therapy — increase evidence weight"
    },
    "hba1c_above_8": {
      "patient_match_weight_boost": 0.05,
      "rationale": "Poor glycemic control needs more aggressive diabetes management — increase match weight"
    }
