# ── API keys ──────────────────────────────────────────────────────────────────
# Set the key for whichever model provider you use.
# All models are routed through LiteLLM — pick one (or more) below.

# DeepSeek V4 via LiteLLM (default)
# Get yours at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Gemini via Google AI Studio (used when model is gemini/...)
# Get yours at: https://aistudio.google.com/app/apikey
# GOOGLE_API_KEY=your-google-api-key-here


# OpenAI (used when model is openai/...)
# OPENAI_API_KEY=your-openai-api-key-here

# Anthropic (used when model is anthropic/...)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Gemini via Vertex AI — no API key needed, uses GCP credentials instead.
# To switch from AI Studio to Vertex AI, change the model prefix from gemini/ to vertex_ai/
# and run: gcloud auth application-default login
# VERTEXAI_PROJECT=your-gcp-project-id
# VERTEXAI_LOCATION=us-central1


# ── Optional: API keys for authenticated agents ───────────────────────────────

# The Consilium orchestrator requires X-API-Key.
# You can provide one or more valid keys in either format below.

# Comma-separated format:
# API_KEYS=my-secret-key-1,my-secret-key-2

# Or named slots:
# API_KEY_PRIMARY=my-secret-key-1
# API_KEY_SECONDARY=my-secret-key-2



# ── Model selection (per agent) ────────────────────────────────────────────────
# All models are routed through LiteLLM — use the provider-prefixed format.
# If not set, all agents default to deepseek/deepseek-v4-flash.
#
# ── DeepSeek V4 via LiteLLM (default — only DEEPSEEK_API_KEY needed) ──────────
GENERAL_AGENT_MODEL=deepseek/deepseek-v4-flash
HEALTHCARE_AGENT_MODEL=deepseek/deepseek-v4-flash
CARDIOLOGY_AGENT_MODEL=deepseek/deepseek-v4-flash
NEPHROLOGY_AGENT_MODEL=deepseek/deepseek-v4-flash
ENDOCRINOLOGY_AGENT_MODEL=deepseek/deepseek-v4-flash
ORCHESTRATOR_MODEL=deepseek/deepseek-v4-flash

# Higher-quality DeepSeek V4 option:
# GENERAL_AGENT_MODEL=deepseek/deepseek-v4-pro
# HEALTHCARE_AGENT_MODEL=deepseek/deepseek-v4-pro
# CARDIOLOGY_AGENT_MODEL=deepseek/deepseek-v4-pro
# NEPHROLOGY_AGENT_MODEL=deepseek/deepseek-v4-pro
# ENDOCRINOLOGY_AGENT_MODEL=deepseek/deepseek-v4-pro
# ORCHESTRATOR_MODEL=deepseek/deepseek-v4-pro
#
# ── Gemini via Google AI Studio ───────────────────────────────────────────────
# GENERAL_AGENT_MODEL=gemini/gemini-2.5-flash
# HEALTHCARE_AGENT_MODEL=gemini/gemini-2.5-flash
# CARDIOLOGY_AGENT_MODEL=gemini/gemini-2.5-flash
# NEPHROLOGY_AGENT_MODEL=gemini/gemini-2.5-flash
# ENDOCRINOLOGY_AGENT_MODEL=gemini/gemini-2.5-flash
# ORCHESTRATOR_MODEL=gemini/gemini-2.5-flash
#
# ── Gemini via Vertex AI (requires VERTEXAI_PROJECT + VERTEXAI_LOCATION + GCP credentials) ──
# GENERAL_AGENT_MODEL=vertex_ai/gemini-2.5-flash
# HEALTHCARE_AGENT_MODEL=vertex_ai/gemini-2.5-flash
# CARDIOLOGY_AGENT_MODEL=vertex_ai/gemini-2.5-flash
# NEPHROLOGY_AGENT_MODEL=vertex_ai/gemini-2.5-flash
# ENDOCRINOLOGY_AGENT_MODEL=vertex_ai/gemini-2.5-flash
# ORCHESTRATOR_MODEL=vertex_ai/gemini-2.5-flash
#
# ── OpenAI (requires OPENAI_API_KEY) ──────────────────────────────────────────
# GENERAL_AGENT_MODEL=openai/gpt-4o-mini
# HEALTHCARE_AGENT_MODEL=openai/gpt-4o-mini
# CARDIOLOGY_AGENT_MODEL=openai/gpt-4o-mini
# NEPHROLOGY_AGENT_MODEL=openai/gpt-4o-mini
# ENDOCRINOLOGY_AGENT_MODEL=openai/gpt-4o-mini
# ORCHESTRATOR_MODEL=openai/gpt-4o-mini
#
# ── Anthropic Claude (requires ANTHROPIC_API_KEY) ─────────────────────────────
# GENERAL_AGENT_MODEL=anthropic/claude-sonnet-4-6
# HEALTHCARE_AGENT_MODEL=anthropic/claude-sonnet-4-6
# CARDIOLOGY_AGENT_MODEL=anthropic/claude-sonnet-4-6
# NEPHROLOGY_AGENT_MODEL=anthropic/claude-sonnet-4-6
# ENDOCRINOLOGY_AGENT_MODEL=anthropic/claude-sonnet-4-6
# ORCHESTRATOR_MODEL=anthropic/claude-sonnet-4-6
#
# You can mix and match — e.g. orchestrator on Gemini, sub-agents on Claude.


# ── Optional: agent public URLs ────────────────────────────────────────────────
# Set these after deploying to Cloud Run so agent cards advertise the correct URL.
# Leave as defaults when running locally.

# ORCHESTRATOR_URL=https://consilium-abc123-uc.a.run.app

# ── Optional: Base URLs ────────────────────────────────────────────────────────
# If using a single tunnel like ngrok, define BASE_URL to have all agents use it.
# BASE_URL=https://my-agent.ngrok-free.app
# The base URL of your Prompt Opinion workspace (applies to FHIR extensions).
# PO_PLATFORM_BASE_URL=https://app.promptopinion.ai


# ── Optional: logging ──────────────────────────────────────────────────────────

# Log the full JSON-RPC request body on every incoming request (default: false).
# Keep false in production because A2A metadata can include FHIR credentials.
# LOG_FULL_PAYLOAD=false

# Print FHIR URL, patient id, and full FHIR tool payloads for local debugging only.
# Keep false in production.
# LOG_FHIR_DEBUG=false

# Specialist LLM call timeout before that specialty falls back deterministically.
# SPECIALIST_AGENT_TIMEOUT_SECONDS=30

# Dump the raw llm_request and callback_context objects before every LLM call.
# Useful when debugging a new metadata integration. (default: false)
# LOG_HOOK_RAW_OBJECTS=false
